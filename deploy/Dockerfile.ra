FROM public.ecr.aws/docker/library/python:3.12-slim

RUN pip install --no-cache-dir awslabs.aws-api-mcp-server==1.3.33

RUN python3 -c "\
import urllib.request, os; \
url='https://dl.k8s.io/release/v1.31.0/bin/linux/amd64/kubectl'; \
urllib.request.urlretrieve(url, '/usr/local/bin/kubectl'); \
os.chmod('/usr/local/bin/kubectl', 0o755)"

# AWS Signing Helper for Roles Anywhere credential_process
RUN python3 -c "\
import urllib.request, os, zipfile, io; \
url='https://rolesanywhere.amazonaws.com/releases/1.4.0/X86_64/Linux/aws_signing_helper'; \
urllib.request.urlretrieve(url, '/usr/local/bin/aws_signing_helper'); \
os.chmod('/usr/local/bin/aws_signing_helper', 0o755)"

RUN apt-get update && apt-get install -y --no-install-recommends \
    jq awscli \
    && rm -rf /var/lib/apt/lists/*

COPY src/entrypoint.py /app/entrypoint.py
COPY src/cn_inventory.py /app/cn_inventory.py
COPY deploy/credential-helper.sh /app/credential-helper.sh
COPY deploy/entrypoint-ra.sh /app/entrypoint-ra.sh

RUN useradd --create-home --shell /bin/bash app && \
    mkdir -p /app/certs && chown app:app /app/certs
USER app
WORKDIR /home/app

EXPOSE 8000

CMD ["/app/entrypoint-ra.sh"]
